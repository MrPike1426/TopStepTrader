<UserControl x:Class="TopStepTrader.UI.Views.UltimateScalperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- FEAT-67 F1: right-align the numeric watchlist cells (MA200, VWAP, Last, RSI). -->
        <Style x:Key="RightAlignedCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!--
            FEAT-67 F2: transient row-update flash. Tag binds (NotifyOnTargetUpdated=True) to
            the row's LastUpdatedTick counter — when the orchestrator bumps it, the resulting
            Binding.TargetUpdated event fires the storyboard, which dips the row's Opacity to
            0.4 and back to 1.0 over 200 ms. This matches the pattern already used by the
            HeaderStatusText flash above and sidesteps the WPF "immutable Setter.Value brush"
            constraint that prevents ColorAnimation against a Background set via a Style
            setter. Opacity is also explicitly listed as an acceptable target in the ticket
            (F2: "Storyboard targeting Background (or Opacity)").
        -->
        <Style x:Key="WatchlistRowStyle" TargetType="DataGridRow">
            <Setter Property="Tag" Value="{Binding LastUpdatedTick, NotifyOnTargetUpdated=True}"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.4" To="1.0"
                                             Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- ── Page title + master toggle + status badge ── -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#x26A1;  Ultimate Scalper"
                           Style="{StaticResource PageTitleStyle}"
                           VerticalAlignment="Center"/>

                <ToggleButton Grid.Column="2"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              Padding="14,6" Margin="0,0,12,0"
                              VerticalAlignment="Center" Cursor="Hand"
                              BorderThickness="1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Content" Value="Enable Scanner"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="#3A5A8A"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="Disable Scanner"/>
                                    <Setter Property="Background" Value="#228B22"/>
                                    <Setter Property="BorderBrush" Value="#1B6F1B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Border Grid.Column="3"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                        BorderBrush="#3A5A8A" BorderThickness="1"
                        Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Status: " Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── FEAT-65: header status line — warmup counts then scan heartbeat ── -->
            <TextBlock Text="{Binding HeaderStatusText, NotifyOnTargetUpdated=True}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,12">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.4" To="1.0" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <!-- ── Live position card (visible only when in position) ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="#3A5A8A" BorderThickness="1"
                    Padding="16" Margin="0,0,0,12"
                    Visibility="{Binding LivePosition.HasPosition, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Live Position"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbol"   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LivePosition.Symbol}" FontSize="14" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Side"     Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LivePosition.SideText}" FontSize="14" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Entry"    Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LivePosition.EntryPrice}" FontSize="14"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Last"     Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LivePosition.LastPrice}" FontSize="14"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" Text="Current SL"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding LivePosition.CurrentStopPrice}" FontSize="14" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Text="Dist-to-Stop"    Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LivePosition.DistanceToStopDollars, StringFormat='${0:F2}'}" FontSize="14"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,12,0,0" Text="Peak Favorable"  Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LivePosition.PeakFavorableDollars, StringFormat='${0:F2}'}" FontSize="14"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,12,0,0" Text="Live P&amp;L"     Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LivePosition.LivePnlDollars, StringFormat='${0:F2}'}" FontSize="14" FontWeight="SemiBold"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Background="#1F3A1F" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                Visibility="{Binding LivePosition.HasBreakevenSnapped, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="BE Snapped" Foreground="#7FE07F" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center">
                            <Run Text="Broker SL edits this second: "/>
                            <Run Text="{Binding LivePosition.EditsThisSecond, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Settings panel ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="16">
                <StackPanel>
                    <!-- Per-instrument trail — single wide row: MES / MNQ / MGC side-by-side -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header row: field labels above each instrument's three editable columns -->
                        <TextBlock Grid.Row="0" Grid.Column="1"  Text="1st Stop ($)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"  Text="BE Snap"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"  Text="SL Dist"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="5"  Text="1st Stop ($)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="6"  Text="BE Snap"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="7"  Text="SL Dist"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="9"  Text="1st Stop ($)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="10" Text="BE Snap"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="11" Text="SL Dist"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>

                        <!-- Value row: instrument label + three editable fields per instrument -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MES" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,8,4"/>
                        <TextBox    Grid.Row="1" Grid.Column="1" Text="{Binding MesInitialStopDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox    Grid.Row="1" Grid.Column="2" Text="{Binding MesBreakevenSnapDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox    Grid.Row="1" Grid.Column="3" Text="{Binding MesTrailDistanceDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="MNQ" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,4"/>
                        <TextBox    Grid.Row="1" Grid.Column="5" Text="{Binding MnqInitialStopDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox    Grid.Row="1" Grid.Column="6" Text="{Binding MnqBreakevenSnapDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox    Grid.Row="1" Grid.Column="7" Text="{Binding MnqTrailDistanceDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="8" Text="MGC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,4"/>
                        <TextBox    Grid.Row="1" Grid.Column="9"  Text="{Binding MgcInitialStopDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox    Grid.Row="1" Grid.Column="10" Text="{Binding MgcBreakevenSnapDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox    Grid.Row="1" Grid.Column="11" Text="{Binding MgcTrailDistanceDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                    </Grid>

                    <Separator Margin="0,12,0,12"/>

                    <!-- Global tunables -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="RSI Oversold"     Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="RSI Overbought"   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Recency Bars"     Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Ceiling TP ($)"   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Leverage (×)"     Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>

                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding RsiOversold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RsiOverbought, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding MaxBarsSinceMidlineCross, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SafetyCeilingTpDollars, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Leverage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                    </Grid>

                    <Separator Margin="0,12,0,12"/>

                    <!-- FEAT-69: pre-staged stop-entry knobs. Master toggle on the left;
                         tunables (offset, re-price drift, stale TTL, debounce) follow. Last two
                         columns are read-only displays of v1-locked values. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pre-staged"          Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Trigger Offset (t)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Re-price Δ (t)"     Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Stale TTL (min)"    Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Re-arm Debounce (s)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Calls/min cap"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Max positions"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0"/>

                        <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding PreStagedEntriesEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="6,4"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding EntryTriggerOffsetTicks, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox  Grid.Row="1" Grid.Column="2" Text="{Binding RepriceThresholdTicks, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox  Grid.Row="1" Grid.Column="3" Text="{Binding ArmStaleMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBox  Grid.Row="1" Grid.Column="4" Text="{Binding ReArmDebounceSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding MaxBrokerCallsPerMinute, Mode=OneWay}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="6,4" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding MaxConcurrentPositions, Mode=OneWay}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="6,4" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Watchlist (MES / MNQ / MGC) ── -->
            <Border Margin="0,12,0,0"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="16">
                <DataGrid ItemsSource="{Binding WatchlistRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="Transparent" BorderThickness="0"
                          RowStyle="{StaticResource WatchlistRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Symbol"    Binding="{Binding Symbol}"          Width="70"/>
                        <DataGridTextColumn Header="Name"      Binding="{Binding DisplayName}"     Width="100"/>
                        <!-- BUG-96 follow-on: signal-driven direction glyph (▲ / ▼ / blank) coloured by SignalState.
                             Replaces the original FEAT-67 F3 Image cell whose icon resources did not resolve in UAT. -->
                        <DataGridTemplateColumn Header="" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DirectionText}"
                                               FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SignalState}" Value="Bullish">
                                                        <Setter Property="Foreground" Value="{StaticResource BuyBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SignalState}" Value="Bearish">
                                                        <Setter Property="Foreground" Value="{StaticResource SellBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Last"      Binding="{Binding LastClose, StringFormat=N2}"
                                            Width="90"  ElementStyle="{StaticResource RightAlignedCellText}"/>
                        <DataGridTextColumn Header="MA200(5m)" Binding="{Binding Ma200, StringFormat=N2}"
                                            Width="100" ElementStyle="{StaticResource RightAlignedCellText}"/>
                        <DataGridTextColumn Header="VWAP"      Binding="{Binding Vwap, StringFormat=N2}"
                                            Width="100" ElementStyle="{StaticResource RightAlignedCellText}"/>
                        <DataGridTextColumn Header="RSI"       Binding="{Binding RsiText}"
                                            Width="60"  ElementStyle="{StaticResource RightAlignedCellText}"/>
                        <DataGridTextColumn Header="Recency"   Binding="{Binding RecencyText}"     Width="60"/>
                        <DataGridTextColumn Header="Signal"    Binding="{Binding SignalState}"     Width="80"/>
                        <!-- FEAT-69: armed stop-entry indicator. Shows "↑ 4523.50" / "↓ 4527.00" when primed, blank otherwise. -->
                        <DataGridTextColumn Header="Armed"     Binding="{Binding ArmedText}"       Width="100"/>
                        <DataGridTextColumn Header="Reason"    Binding="{Binding RejectionReason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ── Signal log ── -->
            <Border Margin="0,12,0,0"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Signal Log" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <DataGrid ItemsSource="{Binding SignalLog}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent" RowBackground="Transparent"
                              AlternatingRowBackground="Transparent" BorderThickness="0"
                              MinHeight="160" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time"   Binding="{Binding TimestampLocalText}" Width="90"/>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}"             Width="70"/>
                            <DataGridTextColumn Header="Side"   Binding="{Binding Side}"               Width="80"/>
                            <DataGridTextColumn Header="Close"  Binding="{Binding Close}"              Width="90"/>
                            <DataGridTextColumn Header="RSI"    Binding="{Binding Rsi, StringFormat=F1}" Width="60"/>
                            <DataGridTextColumn Header="Notes"  Binding="{Binding Notes}"              Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
