<UserControl x:Class="TopStepTrader.UI.Views.BreakAndBounceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- ── Page title + master toggle + status badge ── -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#x1F501;  Break &amp; Bounce"
                           Style="{StaticResource PageTitleStyle}"
                           VerticalAlignment="Center"/>

                <ToggleButton Grid.Column="2"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              Padding="14,6" Margin="0,0,12,0"
                              VerticalAlignment="Center" Cursor="Hand"
                              BorderThickness="1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Content" Value="Enable Break &amp; Bounce"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="#3A5A8A"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="Disable Break &amp; Bounce"/>
                                    <Setter Property="Background" Value="#228B22"/>
                                    <Setter Property="BorderBrush" Value="#1B6F1B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Border Grid.Column="3"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                        BorderBrush="#3A5A8A" BorderThickness="1"
                        Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Status: " Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding HeaderStatusText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,12"/>

            <!-- ── Strategy summary ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="#3A5A8A" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Previous-day breakout + retest + candle confirmation"
                               Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#8090A0" FontSize="12" LineHeight="17">
                        Bias from the most recent closed daily H/L: a 15m bar closing above prev high
                        (or below prev low) sets the dir. Entries fire when a 5m bar retests that level
                        AND prints a hammer / strict outside-bar engulfing. Initial SL is the furthest
                        of (PDF rule, fixed ticks, ATR fraction). No fixed take-profit — break-even
                        ratchet once the trade moves one initial-SL distance in our favor; force-flat
                        on the configured RTH flat window.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ── Config card ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Tunables" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,2,8,6">
                            <TextBlock Text="Entry window (HHmm-HHmm)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding EntryWindow, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2,8,6">
                            <TextBlock Text="Flat window (HHmm-HHmm)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding FlatWindow, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,2,8,6">
                            <TextBlock Text="Min stop (ticks)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding MinimumStopDistanceTicks, UpdateSourceTrigger=LostFocus}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,2,0,6">
                            <TextBlock Text="Min stop (× ATR)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding MinimumStopAtrFraction, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="Long"                  IsChecked="{Binding EnableLong, Mode=TwoWay}"                       Foreground="White" Margin="0,0,12,0"/>
                        <CheckBox Content="Short"                 IsChecked="{Binding EnableShort, Mode=TwoWay}"                      Foreground="White" Margin="0,0,12,0"/>
                        <CheckBox Content="AI veto"               IsChecked="{Binding AiVetoEnabled, Mode=TwoWay}"                    Foreground="White" Margin="0,0,12,0"/>
                        <CheckBox Content="Counter-breakout reset" IsChecked="{Binding InvalidateDirOnCounterBreakout, Mode=TwoWay}"   Foreground="White" Margin="0,0,12,0"/>
                        <CheckBox Content="Window-expiry reset"   IsChecked="{Binding InvalidateDirOnWindowExpiry, Mode=TwoWay}"      Foreground="White" Margin="0,0,12,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Watchlist ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Symbol"       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Signal"       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Dir"          Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Prev H"       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource RightCell}"/>
                        <TextBlock Grid.Column="4" Text="Prev L"       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource RightCell}"/>
                        <TextBlock Grid.Column="5" Text="Pattern"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="Reason"       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="7" Text="Updated"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource RightCell}"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding WatchlistRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Symbol}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SignalState}"
                                               Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DirectionText}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PrevHigh, StringFormat=F2}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12" Style="{StaticResource RightCell}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PrevLow, StringFormat=F2}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12" Style="{StaticResource RightCell}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding PatternHit}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="6" Text="{Binding RejectionReason}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RejectionReason}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding LastUpdatedText}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" Style="{StaticResource RightCell}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ── Live position card ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,12"
                    DataContext="{Binding LivePosition}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Live Position"
                               Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1"
                               Text="No Break &amp; Bounce position open."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               Visibility="{Binding HasPosition, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <Grid Grid.Row="1"
                          Visibility="{Binding HasPosition, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Symbol / Side" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Symbol}" Foreground="White" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="  "/>
                                <TextBlock Text="{Binding SideText}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Entry" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding EntryPrice, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Current SL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding CurrentStopPrice, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Last" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding LastPrice, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Signal log ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition MaxHeight="240"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0D47A1" CornerRadius="5,5,0,0" Padding="10,6">
                        <TextBlock Text="Signal Log" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SignalLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#263238" BorderThickness="0,0,0,1" Padding="10,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimestampLocalText}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="White" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Side}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Close, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Pattern}" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Grid.Column="5" Text="{Binding StopPrice, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Grid.Column="6" Text="{Binding StopFloorSource}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
