<UserControl x:Class="TopStepTrader.UI.Views.SlipStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- ── Page title + master toggle + status badge ── -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#x1F30A;  SlipStream"
                           Style="{StaticResource PageTitleStyle}"
                           VerticalAlignment="Center"/>

                <ToggleButton Grid.Column="2"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              Padding="14,6" Margin="0,0,12,0"
                              VerticalAlignment="Center" Cursor="Hand"
                              BorderThickness="1">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Content" Value="Enable SlipStream"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="#3A5A8A"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="Disable SlipStream"/>
                                    <Setter Property="Background" Value="#228B22"/>
                                    <Setter Property="BorderBrush" Value="#1B6F1B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Border Grid.Column="3"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                        BorderBrush="#3A5A8A" BorderThickness="1"
                        Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Status: " Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Header status: warmup counts then scan heartbeat ── -->
            <TextBlock Text="{Binding HeaderStatusText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,12"/>

            <!-- ── Strategy summary blurb ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="#3A5A8A" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Trend pullback with ATR-adaptive partial+trail exits"
                               Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#8090A0" FontSize="12" LineHeight="17">
                        Long signals require: trend bias (EMA21 &gt; EMA200 AND close &gt; EMA200, optionally close &gt; HTF EMA), price extended ≥ ExtendAtrMult × ATR away from EMA21 in the last few bars then pulling back to tag it, RSI ≥ RsiLongMin, DI+ &gt; DI−, ADX ≥ AdxMin, ATR percentile ≥ AtrPercentMin. Short mirrors. Exits: SL at AtrSLmult × ATR; partial Tp1Pct% at AtrTP1mult × ATR; runner trails at TrailMult × ATR once price moves TrailOffsetMult × ATR in favor; force-flat window and max-bars time stop bound duration.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ── Config card (key tunables) ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Tunables" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,2,8,6">
                            <TextBlock Text="ADX min" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding AdxMin, UpdateSourceTrigger=LostFocus, StringFormat=F1}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2,8,6">
                            <TextBlock Text="ATR % min" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding AtrPercentMin, UpdateSourceTrigger=LostFocus, StringFormat=F0}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,2,8,6">
                            <TextBlock Text="RSI long ≥" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding RsiLongMin, UpdateSourceTrigger=LostFocus, StringFormat=F0}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,2,0,6">
                            <TextBlock Text="RSI short ≤" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding RsiShortMax, UpdateSourceTrigger=LostFocus, StringFormat=F0}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,2,8,6">
                            <TextBlock Text="Risk % / trade" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding RiskPct, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,8,6">
                            <TextBlock Text="SL × ATR" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding AtrSLmult, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,2,8,6">
                            <TextBlock Text="TP1 × ATR" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding AtrTP1mult, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,2,0,6">
                            <TextBlock Text="TP1 % to close" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding Tp1Pct, UpdateSourceTrigger=LostFocus, StringFormat=F0}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,2,8,6">
                            <TextBlock Text="Trail × ATR" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding TrailMult, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,2,8,6">
                            <TextBlock Text="Trail activation × ATR" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding TrailOffsetMult, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,2,8,6">
                            <TextBlock Text="Session (HHmm-HHmm)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding SessionWindow, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,2,0,6">
                            <TextBlock Text="Flat window" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding FlatWindow, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="Long" IsChecked="{Binding EnableLong, Mode=TwoWay}" Foreground="White" Margin="0,0,12,0"/>
                        <CheckBox Content="Short" IsChecked="{Binding EnableShort, Mode=TwoWay}" Foreground="White" Margin="0,0,12,0"/>
                        <CheckBox Content="Session filter" IsChecked="{Binding UseSession, Mode=TwoWay}" Foreground="White" Margin="0,0,12,0"/>
                        <CheckBox Content="HTF bias filter" IsChecked="{Binding UseHtfFilter, Mode=TwoWay}" Foreground="White" Margin="0,0,12,0"/>
                        <TextBlock Text="HTF:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding HtfTimeframe, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,12,0"/>
                        <TextBlock Text="Session TZ:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                   ToolTip="Windows time zone id (e.g. 'Central Standard Time', 'GMT Standard Time') or IANA id (e.g. 'America/Chicago', 'Europe/London'). Session and Flat windows are interpreted in this zone."/>
                        <ComboBox IsEditable="True"
                                  Text="{Binding SessionTimeZone, UpdateSourceTrigger=LostFocus}"
                                  Width="180"
                                  ToolTip="Windows time zone id or IANA id. DST is respected.">
                            <ComboBoxItem Content="Central Standard Time"/>
                            <ComboBoxItem Content="GMT Standard Time"/>
                            <ComboBoxItem Content="Eastern Standard Time"/>
                            <ComboBoxItem Content="UTC"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Watchlist ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Symbol"   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Signal"   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Close"    Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource RightCell}"/>
                        <TextBlock Grid.Column="3" Text="ADX"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource RightCell}"/>
                        <TextBlock Grid.Column="4" Text="RSI"      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource RightCell}"/>
                        <TextBlock Grid.Column="5" Text="ATR pct"  Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource RightCell}"/>
                        <TextBlock Grid.Column="6" Text="Reason"   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="7" Text="Updated"  Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource RightCell}"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding WatchlistRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Symbol}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SignalState}"
                                               Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LastClose, StringFormat=F2}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12" Style="{StaticResource RightCell}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding AdxText}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12" Style="{StaticResource RightCell}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding RsiText}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12" Style="{StaticResource RightCell}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding AtrPercentRankText}"
                                               Foreground="White" FontFamily="Consolas" FontSize="12" Style="{StaticResource RightCell}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding RejectionReason}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RejectionReason}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding LastUpdatedText}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" Style="{StaticResource RightCell}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ── Live position card ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,12"
                    DataContext="{Binding LivePosition}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Text="Live Position" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- Flat state -->
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                               Text="No SlipStream position open."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               Visibility="{Binding HasPosition, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <!-- Open state -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="2"
                          Visibility="{Binding HasPosition, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                            <TextBlock Text="Symbol / Side" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Symbol}" Foreground="White" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="  "/>
                                <TextBlock Text="{Binding SideText}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,6">
                            <TextBlock Text="Entry" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding EntryPrice, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,6">
                            <TextBlock Text="Last" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding LastPrice, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,6">
                            <TextBlock Text="Live P&amp;L ($)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding LivePnlDollars, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Current SL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding CurrentStopPrice, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="TP1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tp1Price, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                                <TextBlock Text="  filled" Foreground="#66BB6A" FontSize="11" VerticalAlignment="Center"
                                           Visibility="{Binding Tp1Filled, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Peak fav. ($)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding PeakFavorableDollars, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3">
                            <TextBlock Text="Trail" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Foreground="White" FontFamily="Consolas" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="armed —"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrailArmed}" Value="True">
                                                <Setter Property="Text" Value="ARMED"/>
                                                <Setter Property="Foreground" Value="#66BB6A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TrailArmed}" Value="False">
                                                <Setter Property="Text" Value="—"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Signal log ── -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition MaxHeight="240"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0D47A1" CornerRadius="5,5,0,0" Padding="10,6">
                        <TextBlock Text="Signal Log" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SignalLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#263238" BorderThickness="0,0,0,1" Padding="10,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimestampLocalText}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="White" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Side}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Close, StringFormat=F2}" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Rsi, StringFormat=F1}" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Adx, StringFormat=F1}" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Notes}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
