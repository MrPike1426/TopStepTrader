<Window x:Class="TopStepTrader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TopStep AI Trader"
        Icon="/Assets/app.ico"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1100"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BUG-94 F4: orphan-position alarm banner -->
        <Border Grid.Column="1" Grid.Row="0"
                Background="#7A2A2A" BorderBrush="#FF5555" BorderThickness="0,0,0,2"
                Padding="14,8"
                Visibility="{Binding OrphanAlarm.IsActive, Converter={StaticResource BoolToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding OrphanAlarm.BannerTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="Bold" FontSize="13" Foreground="White"/>
                    <TextBlock Text="{Binding OrphanAlarm.BannerDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="11" Foreground="#FFDADA" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding OrphanAlarm.AutoSlLine, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="11" Foreground="#FFDADA"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Flatten now"
                        Command="{Binding OrphanAlarm.FlattenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="8,0,8,0" Padding="12,4"
                        Background="#FF5555" Foreground="White" BorderBrush="#FF7777"/>
                <Button Grid.Column="2"
                        Content="✕"
                        Command="{Binding OrphanAlarm.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Padding="10,4"
                        Background="Transparent" Foreground="White" BorderBrush="#FF7777"/>
            </Grid>
        </Border>

        <!-- Navigation Sidebar -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="TopStep AI Trader"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="14" FontWeight="Bold"
                           Margin="16,0,16,24" TextWrapping="Wrap"/>

                <Button Content="📊  Dashboard"    Tag="Dashboard"   Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="📈  SuperTrend+" Tag="SuperTrendPlus" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="⚡  Ultimate Scalper" Tag="UltimateScalper" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="&#x1F30A;  SlipStream" Tag="SlipStream" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="&#x1F501;  Break &amp; Bounce" Tag="BreakAndBounce" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="&#x1F50D;  Trade Post-Mortem" Tag="TradePostMortem" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="&#x1F9EA;  Test Trade" Tag="TestTrade" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>

                <!-- Config Section Separator -->
                <Border Margin="16,16,16,8" Height="1" Background="{StaticResource BorderBrush}" Opacity="0.4"/>
                <TextBlock Text="  CONFIG"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" FontWeight="SemiBold"
                           Margin="16,4,16,8" Opacity="0.55"/>

                <Button Content="👤  Personas"     Tag="Persona"     Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="🔑  API Keys"     Tag="ApiKeys"     Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>


                <!-- Connection Status -->
                <Border Margin="16,20,16,8" CornerRadius="4"
                        Background="{Binding ConnectionStatusBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Text="{Binding ConnectionStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="White" FontSize="11" Margin="8,4" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1" Grid.Row="1"
                        x:Name="MainContent"
                        Margin="0"/>
    </Grid>
</Window>
